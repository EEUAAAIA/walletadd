<h2>New blockchain 1</h2>

<%= turbo_frame_tag "new_blockchain" do %>
<br/>
  <section class="adding">
    <%= form_for @user_blockchain do |f| %>
      <%= f.fields_for :blockchain do |b| %>
        <p>
          <%= b.text_field :name, placeholder: t('user_blockchain.edit.name') %>
          <%= b.object.errors[:name].join(", ") if b.object.errors[:name].present? %>

        </p>
        <p>
          <%= b.text_area :description, placeholder: "Description" %>
        </p>
      <% end %>
        <p>
          <button type="submit"><%= t('user_address.new.cancel') %></button>
        </p>
        <p>
          <a href="<%= user_blockchains_path %>"><%= t('user_blockchain.index.h2') %></a>
        </p>
    <% end %>
  </section>
<% end %>

<p>
  <a href="<%= user_blockchains_path %>"><%= t('user_blockchain.edit.back_blockchain') %></a>
</p>
