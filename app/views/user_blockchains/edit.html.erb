<h1> Editer une blockchain </h1>

<%= form_for @user_blockchain do |f| %>

  <h3>Modification de Blockchain</h3>

  <%= f.fields_for :blockchain do |b| %>
    <p>
      Name :  <%= b.text_field :name %>
    </p>
    <p>
      Description:  <%= b.text_area :description %>
    </p>
  <% end %>


<button type="submit"> Enregistrer les modifications </button>

<% end %>

<p>
  <a href="<%= user_blockchains_path %>">Retour aux blockchains</a>
</p>
