<h1><%= t('user_blockchain.edit.h1') %></h1>

<%= form_for @user_blockchain do |f| %>

  <%= f.fields_for :blockchain do |b| %>
    <p>
      <%= t('user_blockchain.edit.name') %>: <%= b.text_field :name %>
    </p>
    <p>
      Description: <%= b.text_area :description %>
    </p>
  <% end %>


<button type="submit"><%= t('user_blockchain.edit.save') %></button>

<% end %>

<p>
  <a href="<%= user_blockchains_path %>"><%= t('user_blockchain.edit.back_blockchain') %></a>
</p>
