<h1><%= t('user_address.edit.h1') %></h1>

<%= form_for @user_address do |f| %>

  <%= f.fields_for :address do |a| %>
    <p>
      Alias: <%= a.text_field :username %>
    </p>
    <p>
      <%= t('user_address.index.address') %>:  <%= a.text_field :address %>
    </p>

    <p>
      <%= a.select :wallet_id, options_for_select(@wallets, @address.wallet_id) %>
    </p>
  <% end %>

  <button type="submit"><%= t('user_address.edit.save') %></button>

<% end %>

<p>
  <a href="<%= user_addresses_path %>"><%= t('user_address.edit.back_address') %></a>
</p>
