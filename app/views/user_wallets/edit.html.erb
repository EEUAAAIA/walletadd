<h1><%= t('user_wallet.edit.h1') %></h1>

<%= form_for @user_wallet do |f| %>

  <%= f.fields_for :wallet do |w| %>
    <p>
      <%= t('user_wallet.edit.name') %>: <%= w.text_field :name %>
    </p>

    <p>
      Blockchain: <%= w.select :blockchain_id, options_for_select(@blockchains, @wallet.blockchain_id) %>
    </p>
  <% end %>

  <button type="submit"><%= t('user_wallet.edit.save') %></button>

<% end %>

<p>
  <a href="<%= user_wallets_path %>"><%= t('user_wallet.edit.back_blockchain') %></a>
</p>
