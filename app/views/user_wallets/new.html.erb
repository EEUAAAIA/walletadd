<h2>New Wallet 1</h2>

<%= turbo_frame_tag "new_wallet" do %>
<br/>
  <section class="adding">
    <%= form_for @user_wallet do |f| %>
      <%= f.fields_for :wallet do |w| %>
        <p>
          <%= w.text_field :name, placeholder: t('user_wallet.edit.name') %>
        </p>
        <p>
          <%= w.label :blockchain_id, "Blockchain" %>
          <%= w.select :blockchain_id, options_for_select(@blockchains) %>
        </p>
      <% end %>
        <p>
          <button type="submit"><%= t('user_wallet.edit.save')%></button>
        </p>
        <p>
          <a href="<%= user_wallets_path %>"><%= t('user_wallet.edit.back_wallet')%></a>
        </p>
    <% end %>
  </section>
<% end %>

<p>
  <a href="<%= user_wallets_path %>"><%= t('user_wallet.edit.back_wallet')%></a>
</p>
