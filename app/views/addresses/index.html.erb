<h1>Addresses</h1>

<section>
  <% if notice.present? %>
    <p>
      <%= notice %>
    </p>
  <% end %>
</section>
<br>

<!--Création d'adresse-->
<section class="adding">
  <p>
    <%= link_to "Créer une adresse",
                  new_address_path,
                  class: 'button_add',
                  data: { turbo_frame: "new_address" } %>
  </p>
  <br>
</section>
<section>
  <%= turbo_frame_tag "new_address" %>
</section>

<!--Affichage mobile/tabllete-->
<section class="info_mobile">
  <% @addresses.each do |address| %>
    <article data-controller="clipboard" class="info_mobile_list">
      <p>
        Username : <%= address.username %>
      </p>
      <p>
        Address: <span class="span_address"><%= address.address %></span>
      </p>
      <p class="action">
        <a data-action="click->clipboard#copy">
        <!--Copier Coller-->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
            <path fill="none" d="M0 0h24v24H0z"/>
            <path d="M14 1H5a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zM5 19V5h9v14H5z"/>
            <path d="M17 4H7a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1zM8 6h8v2H8V6zm0 4h8v2H8v-2zm0 4h6v2H8v-2z"/>
          </svg>
        </a>
        <!--Lire la suite-->
        <a href="<%= address_path(address.id)%>">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M21.707 20.293l-4.146-4.146a7.98 7.98 0 001.646-4.883c0-4.411-3.589-8-8-8s-8 3.589-8 8 3.589 8 8 8a7.98 7.98 0 004.883-1.646l4.146 4.146a1 1 0 101.414-1.414zM4 10c0-3.309 2.691-6 6-6s6 2.691 6 6-2.691 6-6 6-6-2.691-6-6z"/></svg>
        </a>
        <a href="<%= edit_address_path(address.id)%>">Editer</a>
        <%= button_to "Delete",
                      address_path(address),
                      method: :delete,
                      data: { action: "address#delete" }%>
      </p>
    </article>
  <% end%>
</section>

<!--Affichage ordinateur-->
<section class="info_pc">
  <table class="table_info" data-controller="clipboard">
    <thead>
      <tr>
        <th class="top-left">Username</th>
        <th>Address</th>
        <th class="top-right">Actions</th>
    </tr>
  </thead>
    <tbody>
      <% @addresses.each do |address| %>
      <tr>
          <td class="bottom-left">
            <%= address.username %>
          <br>
          </td>
          <td>
            <span class="span_address"><%= address.address %></span>
            <br>
          </td>
          <td class="bottom-right">
            <p class="action">
              <button data-action="click->clipboard#copy" class="action_element">Copy to Clipboard</button>
              <a href="<%= address_path(address.id)%>" class="action_element">Lire la suite</a>
              <a href="<%= edit_address_path(address.id)%>" class="action_element">Editer</a>
              <%= button_to "Delete",
                            address_path(address),
                            method: :delete,
                            data: { action: "address#delete" }%>
          </p>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
</section>
