<h2><%= t('user_address.new.h2') %></h2>

<%= turbo_frame_tag "new_address" do %>

  <section class="adding">
    <br>
    <%= form_for @address do |f| %>
      <p>
        <%= f.text_area :username, placeholder: "Alias" %>
      </p>
      <p>
        <%= f.text_area :address, placeholder: t('user_address.index.address') %>
      </p>
      <p>
        <%= f.label :wallet_id, t('home.index.wallet.title') %>
        <%= f.select :wallet_id, options_for_select(@wallets, @address.wallet_id) %>
      </p>
      <p>
        <button type="submit"><%= t('user_address.edit.save') %></button>
      </p>
      <p>
        <a href="<%= addresses_path %>"><%= t('user_address.new.cancel') %></a>
      </p>
    <% end %>
  </section>

<% end %>



<p>
  <a href="<%= addresses_path %>">Retour aux addresses</a>
</p>
